# Upstash Redis is added from Vercel → Storage; these are injected automatically (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: skip /setup and use this password (change-password is then disabled).
ADMIN_PASSWORD=
# Optional: extra cookie-signing salt.
SECRET=
